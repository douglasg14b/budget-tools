# Loaded by every `pnpm test` Vitest run (apps/api, apps/web) instead of .env.local, which
# points at production. Committed on purpose: nothing secret and nothing remote belongs here.
# Tests use in-process PGlite for Postgres and local temp dirs for files; the Vitest setup
# also strips remote-pointing variables (DB_CONNECTION_STRING, *_S3_*, YNAB_API_KEY, ...) and
# blocks non-loopback network connections, whatever the shell or this file says.
RECEIPTS_STORAGE=fs
AMAZON_SYNC_INTERVAL_MS=0
