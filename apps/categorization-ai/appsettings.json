{
    "ML": {
        "ConfidenceThreshold": 0.85,
        "LookupVoteShareThreshold": 0.8,
        "AmbiguousPayeeVoteShareThreshold": 0.95,
        "MinCategoryTrainingExamples": 5,
        "CategoryModelPath": "models/category-model.zip",
        "GroupModelPath": "models/group-model.zip",
        "PayeeModelPath": "models/payee-model.zip",
        "ExportCsvPath": "data.csv",
        "ValidationHoldoutFraction": 0.15,
        "Consensus": {
            "ConfidenceThreshold": 0.9,
            "MinAgreeingMethods": 3,
            "MinAgreeingMethodsWithStrongSignal": 2,
            "ImportAmountSoloThreshold": 0.98,
            "AllowStrongSignalPair": false,
            "EligibleMethods": [
                "ImportAmountLookup",
                "HierarchicalModel",
                "CategoryModel",
                "PeriodicSeriesLookup"
            ],
            "StrongSignalMethods": [
                "ImportAmountLookup",
                "HierarchicalModel",
                "PeriodicSeriesLookup"
            ]
        },
        "Ambiguity": {
            "MinSamples": 3,
            "MinTopVoteShare": 0.8,
            "TemporalHalfLifeDays": 365
        },
        "PayeeResolution": {
            "FuzzyMatchThreshold": 0.85,
            "FuzzyAmbiguityMargin": 0.05,
            "OversampleSingletonWeight": 5,
            "OversampleDoubleWeight": 3,
            "OversampleTripleWeight": 2
        },
        "PeriodicSeries": {
            "MinOccurrences": 3,
            "CadenceMatchRatio": 0.7,
            "AmountRelativeTolerance": 0.08,
            "AmountAbsoluteToleranceMilliunits": 1000,
            "StableCategoryVoteShare": 0.85,
            "MaxMissedPeriods": 2,
            "RelatedTransactionIdCap": 8
        },
        "OptionConfidenceFloor": 0.75,
        "MaxRankedOptions": 5
    },
    "ClassificationExclusions": {
        "PayeePatterns": [
            "amazon",
            "amzn",
            "walmart",
            "wal mart",
            "safeway",
            "costco",
            "target",
            "sams club",
            "sam's club",
            "kroger",
            "whole foods",
            "wholefds",
            "aldi",
            "trader joe",
            "meijer",
            "heb",
            "publix"
        ],
        "CheckPatterns": [
            "check",
            "chk",
            "check deposit",
            "mobile check",
            "counter check",
            "check pmt"
        ]
    },
    "Llm": {
        "Enabled": false,
        "ApiKey": "",
        "Model": "gpt-4.1-nano",
        "BaseUrl": "https://api.openai.com/v1"
    },
    "Server": {
        "Port": 4021
    }
}
