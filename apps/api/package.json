{
  "name": "@budget-tools/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm tsoa",
    "dev": "dotenvx run -f ../../.env.local -f .env.local --ignore=MISSING_ENV_FILE -- pnpm --dir ../.. exec tsx watch apps/api/src/server.ts",
    "migrate": "dotenvx run -f ../../.env.local -f .env.local --ignore=MISSING_ENV_FILE -- pnpm --dir ../.. exec tsx apps/api/src/data-persistence/runMigrations.ts",
    "clear:amazon-cache": "dotenvx run -f ../../.env.local -f .env.local --ignore=MISSING_ENV_FILE -- pnpm --dir ../.. exec tsx apps/api/src/features/amazonOrders/clearAmazonOrderCache.ts",
    "prebuild": "pnpm tsoa",
    "build": "tsc -p tsconfig.json --noEmit",
    "postbuild": "pnpm --filter @budget-tools/web-sdk build",
    "pretypecheck": "pnpm tsoa",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenvx run -f ../../.env.local -f .env.local --ignore=MISSING_ENV_FILE -- vitest run --passWithNoTests",
    "tsoa": "dotenvx run -f ../../.env.local -f .env.local --ignore=MISSING_ENV_FILE -- tsoa spec-and-routes"
  },
  "dependencies": {
    "@budget-tools/db": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tsoa/runtime": "7.0.0-alpha.0",
    "better-sqlite3": "^13.0.3",
    "env-var": "^7.5.0",
    "express": "^5.2.1",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "talisman": "^1.1.4",
    "tsoa": "7.0.0-alpha.0"
  },
  "devDependencies": {
    "@budget-tools/config-typescript": "workspace:^",
    "@dotenvx/dotenvx": "^1.31.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.1"
  }
}
