								"schema": {
									"$ref": "#/components/schemas/CategorizationQueueDto"
								}
							}
						}
					}
				},
				"description": "Pending review queue with AI proposals joined to local transaction details.",
				"tags": [
					"categorization"
				],
				"security": [],
				"parameters": [
					{
						"description": "Comma-separated ApprovalTier values to include",
						"in": "query",
						"name": "tier",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Filter to a single YNAB account id",
						"in": "query",
						"name": "accountId",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Enable LLM fallback for this predict run (cache key)",
						"in": "query",
						"name": "llm",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"description": "Force a new predict-json spawn",
						"in": "query",
						"name": "refresh",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					}
				]
			}
		},
