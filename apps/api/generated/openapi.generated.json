		"/categorization/queue": {
			"get": {
				"operationId": "GetCategorizationQueue",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/CategorizationQueueDto"
								}
							}
						}
					}
				},
				"description": "Pending review queue joined to cached local ML proposals.\nWindow queries (`around` / `olderThan` / `newerThan`) list pending rows without scoring.",
				"tags": [
					"categorization"
				],
				"security": [],
				"parameters": [
					{
						"description": "Comma-separated ApprovalTier values to include",
						"in": "query",
						"name": "tier",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Filter to a single YNAB account id",
						"in": "query",
						"name": "accountId",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Case-insensitive substring filter over payee, import names, memo, category, account, date, and amount",
						"in": "query",
						"name": "q",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Discard cached scores and rescore the newest batch",
						"in": "query",
						"name": "refresh",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"description": "Score the next never-scored batch; ignored when refresh is true",
						"in": "query",
						"name": "expand",
						"required": false,
						"schema": {
							"type": "boolean"
						}
					},
					{
						"description": "Center a pending window on this transaction id",
						"in": "query",
						"name": "around",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Next older pending batch after this transaction id",
						"in": "query",
						"name": "olderThan",
						"required": false,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Next newer pending batch before this transaction id",
						"in": "query",
						"name": "newerThan",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				]
			}
		},
