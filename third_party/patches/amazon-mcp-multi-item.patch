+    .waitFor({ state: "visible", timeout: 10000 })
+    .catch(() =>
+      page
+        .getByText(/Grand Total/i)
+        .first()
+        .waitFor({ state: "visible", timeout: 5000 }),
+    )
+    .catch(() => {});
+}
