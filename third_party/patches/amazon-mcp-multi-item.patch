+async function extractOrderDate(page: Page): Promise<Date | null> {
+  const fromComponent = await page.evaluate(() => {
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    const doc = (globalThis as any).document;
+    const node = doc.querySelector('[data-component="orderDate"]');
+    return node ? (node.textContent || "").replace(/\s+/g, " ").trim() : "";
+  });
+  if (fromComponent) {
+    const parsed = parseDate(fromComponent);
+    if (parsed) {
+      return parsed;
+    }
+  }
+  const pageText = (await page.textContent("body").catch(() => "")) || "";
+  const match =
+    pageText.match(/Order\s*Date:?\s*([A-Za-z]+\s+\d{1,2},?\s+\d{4})/i) ||
+    pageText.match(/Placed\s*(?:on)?:?\s*([A-Za-z]+\s+\d{1,2},?\s+\d{4})/i);
+  if (!match?.[1]) {
+    return null;
+  }
+  return parseDate(match[1]);
 }
 
