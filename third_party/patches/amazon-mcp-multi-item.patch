+export const INVOICE_CHARGE_SUMMARY_ROW =
+  '[data-component="chargeSummary"] .od-line-item-row';
+
+export function chargeSummaryLinesFromHtml(html: string): InvoiceAmountLine[] {
+  const rows = html.split(/<div class="a-row od-line-item-row">/).slice(1);
+  const lines: InvoiceAmountLine[] = [];
+  for (const row of rows) {
+    const contentTag = row.search(/<div class="[^"]*od-line-item-row-content/);
+    const labelHtml = contentTag >= 0 ? row.slice(0, contentTag) : row;
+    const valueOpen = contentTag >= 0 ? row.indexOf(">", contentTag) : -1;
+    const valueHtml = valueOpen >= 0 ? row.slice(valueOpen + 1) : "";
+    const label = stripInvoiceHtml(labelHtml);
+    const value = stripInvoiceHtml(valueHtml);
+    if (label || value) {
+      lines.push({ label, value });
+    }
+  }
+  return lines;
+}
+
+function stripInvoiceHtml(html: string): string {
+  return html
+    .replace(/<[^>]+>/g, " ")
+    .replace(/&amp;/g, "&")
+    .replace(/&nbsp;/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+export type InvoiceAmountLine = {
+  readonly label: string;
+  readonly value: string;
+};
+
+export async function waitForInvoiceChargeSummary(page: Page): Promise<void> {
+  // The first .od-line-item-row (subtotal) can paint before Grand Total.
