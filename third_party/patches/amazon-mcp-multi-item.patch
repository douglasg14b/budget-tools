new file mode 100644
index 0000000..d4f7e6f
--- /dev/null
+++ b/tests/unit/invoice-amounts.test.ts
@@ -0,0 +1,92 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+import {
+  chargeSummaryLinesFromHtml,
+  INVOICE_CHARGE_SUMMARY_ROW,
+  parseInvoiceAmountLines,
+} from '../../src/amazon/extractors/invoice';
+
+describe('parseInvoiceAmountLines', () => {
+  it('fills Grand Total and Subscribe & Save after charge-summary only has subtotal', () => {
+    const pageText = [
+      'Items Subtotal: $46.99',
+      'Shipping & Handling: $0.00',
+      'Subscribe & Save: -$7.05',
+      'Grand Total: $39.94',
+    ].join('\n');
+
+    const parsed = parseInvoiceAmountLines(
+      [
+        { label: 'Item(s) Subtotal:', value: '$46.99' },
+        { label: 'Shipping & Handling:', value: '$0.00' },
+      ],
+      pageText,
+      'USD',
+    );
+
+    assert.equal(parsed.subtotal?.amount, 46.99);
+    assert.equal(parsed.total?.amount, 39.94);
+    assert.equal(parsed.gift?.amount, -7.05);
+  });
+
+  it('reads Subscribe & Save from a charge-summary label', () => {
+    const parsed = parseInvoiceAmountLines(
+      [
+        { label: 'Item(s) Subtotal:', value: '$46.99' },
+        { label: 'Subscribe & Save', value: '-$7.05' },
+        { label: 'Grand Total:', value: '$39.94' },
+      ],
+      '',
+      'USD',
+    );
+    assert.equal(parsed.total?.amount, 39.94);
+    assert.equal(parsed.gift?.amount, -7.05);
+  });
+
+  it('sums stacked Subscribe & Save rows from a live invoice', () => {
+    const parsed = parseInvoiceAmountLines(
+      [
+        { label: 'Item(s) Subtotal:', value: '$46.99' },
+        { label: 'Shipping & Handling:', value: '$0.00' },
+        { label: 'Subscribe & Save:', value: '-$4.70' },
+        { label: 'Subscribe & Save:', value: '-$2.35' },
+        { label: 'Total before tax:', value: '$39.94' },
+        { label: 'Estimated tax to be collected:', value: '$0.00' },
+        { label: 'Grand Total:', value: '$39.94' },
+      ],
+      '',
+      'USD',
+    );
+    assert.equal(parsed.subtotal?.amount, 46.99);
+    assert.equal(parsed.total?.amount, 39.94);
+    assert.equal(parsed.gift?.amount, -7.05);
+  });
+
+  it('waits for charge-summary rows, not the empty wrapper', () => {
+    assert.match(INVOICE_CHARGE_SUMMARY_ROW, /chargeSummary/);
+    assert.match(INVOICE_CHARGE_SUMMARY_ROW, /od-line-item-row/);
+    assert.doesNotMatch(INVOICE_CHARGE_SUMMARY_ROW, /purchasedItems/);
+  });
+
+  it('parses Grand Total and stacked Subscribe & Save from saved gloves invoice HTML', () => {
+    const html = readFileSync(
+      join('tests/unit/fixtures/gloves-charge-summary.html'),
+      'utf8',
+    );
+    const lines = chargeSummaryLinesFromHtml(html);
+    assert.equal(lines.length, 7);
+    assert.equal(lines[0]?.label, 'Item(s) Subtotal:');
+    assert.equal(lines[0]?.value, '$46.99');
+    assert.equal(lines[6]?.label, 'Grand Total:');
+    assert.equal(lines[6]?.value, '$39.94');
+
+    const parsed = parseInvoiceAmountLines(lines, '', 'USD');
+    assert.equal(parsed.subtotal?.amount, 46.99);
+    assert.equal(parsed.total?.amount, 39.94);
+    assert.equal(parsed.gift?.amount, -7.05);
+  });
+});
