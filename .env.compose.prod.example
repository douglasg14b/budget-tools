# Environment for docker-compose-prod.yml. In Coolify these are set as the stack's environment
# variables rather than a file; this example documents what the stack expects.
#
# Copy to .env.compose.prod for a local run:
#   docker compose -f docker-compose-prod.yml --env-file .env.compose.prod up -d

# --- Required -----------------------------------------------------------------------------
# The existing shared Postgres (external to this stack — the transactions-retriever already
# uses it). The one-shot migrator applies the schema before any app starts.
DB_CONNECTION_STRING=postgresql://budget_tools_user:CHANGE_ME@postgres.home.lan:5432/budget_tools

YNAB_API_KEY=
YNAB_BUDGET_NAME=
OPENROUTER_API_KEY=

# --- Receipt image storage ----------------------------------------------------------------
# `s3` targets the on-network rust-fs server. Provision the bucket, policy, and service account
# with `node scripts/provision-receipts-s3.mjs`, which prints these values.
# Set to `fs` to fall back to the `receipts-data` volume instead.
RECEIPTS_STORAGE=s3
RECEIPTS_S3_ENDPOINT=https://s3.home.lan
RECEIPTS_S3_BUCKET=budget-tools-receipts
RECEIPTS_S3_ACCESS_KEY_ID=
RECEIPTS_S3_SECRET_ACCESS_KEY=
RECEIPTS_S3_REGION=us-east-1
RECEIPTS_S3_PREFIX=
RECEIPTS_S3_FORCE_PATH_STYLE=true

# --- Categorization models ------------------------------------------------------------------
# The scorer downloads its trained models from S3 at startup — they are gitignored build
# artifacts, so an image built from a git clone has no copy. Publish them with
# `pnpm upload:models`, then restart the scorer.
#
# Credentials and endpoint are reused from the RECEIPTS_S3_* values above (same bucket, models/
# prefix, already covered by the bucket-scoped service account). Only override these to change
# the prefix or to disable S3 model loading entirely.
CATEGORIZATION_MODELS_S3_ENABLED=true
CATEGORIZATION_MODELS_S3_PREFIX=models/

# --- Host ports -----------------------------------------------------------------------------
# Defaults sit in the 18000 range to stay clear of the ports this host already uses.
#
# WEB_PORT is the only one a browser needs: the web client's API base URL is a relative `/api`,
# so nginx serves the SPA and proxies API calls over the internal network. Coolify usually fronts
# this with its own proxy.
WEB_PORT=18080

# API_HOST_PORT publishes the API directly on the host. Not used by the browser - it is for
# health checks, debugging, and running the one-time data migration against the deployed stack.
# Distinct from API_PORT, which is the port the API listens on *inside* the container.
API_HOST_PORT=18020

OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_RECEIPT_REPAIR_MODEL=qwen/qwen3.7-plus
CATEGORIZATION_PREDICT_TIMEOUT_MS=300000

# Deliberately NOT set: AMAZON_ORDERS_MCP_ENTRY. Amazon order sync needs a headed Chromium that
# these images cannot run; leaving it unset makes those endpoints return 503 instead of hanging.
