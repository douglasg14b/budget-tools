API_PORT=4020
API_LISTEN_HOST=0.0.0.0
DB_CONNECTION_STRING=postgresql://budget_tools_user:password@localhost:5432/budget_tools
# Receipt image storage backend: `fs` (local, default) or `s3` (rust-fs in production).
RECEIPTS_STORAGE=fs
# Filesystem backend: repo-root relative (Vitest cwd is apps/api; not resolved from process.cwd()).
RECEIPTS_DIR=apps/api/data/receipts
# One-time S3 provisioning (`pnpm provision:receipts-s3`). Admin credentials for the rust-fs
# server; only needed while provisioning, not at runtime. RUSTFS_ADMIN_ENDPOINT is the S3 API
# endpoint (what an S3 client connects to), NOT the web console — the admin API shares that port.
# RUSTFS_ADMIN_ENDPOINT=https://s3.home.lan
# RUSTFS_ADMIN_ACCESS_KEY=
# RUSTFS_ADMIN_SECRET_KEY=
# S3 backend (RECEIPTS_STORAGE=s3). Provision with `pnpm provision:receipts-s3`.
# RECEIPTS_S3_ENDPOINT=https://s3.home.lan
# RECEIPTS_S3_BUCKET=budget-tools-receipts
# RECEIPTS_S3_ACCESS_KEY_ID=
# RECEIPTS_S3_SECRET_ACCESS_KEY=
# RECEIPTS_S3_REGION=us-east-1
# RECEIPTS_S3_PREFIX=receipts/
# RECEIPTS_S3_FORCE_PATH_STYLE=true
# Where `pnpm upload:models` publishes the trained categorization models (same bucket as
# receipts). Must match the scorer's ModelStorage__Prefix in production.
# CATEGORIZATION_MODELS_S3_PREFIX=models/
# API-wide express.json limit (bytes). Default 15 MiB so receipt data-URL frames fit; oversize bodies return 413.
RECEIPTS_JSON_BODY_LIMIT=15728640
CATEGORIZATION_AI_WORKING_DIR=apps/categorization-ai
CATEGORIZATION_MODELS_DIR=models
CATEGORIZATION_PREDICT_TIMEOUT_MS=300000
CATEGORIZATION_SCORER_URL=http://localhost:4021
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
# Vision model for receipt line-item extraction (not text-only ids).
OPENROUTER_RECEIPT_REPAIR_MODEL=qwen/qwen3.7-plus
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# After `pnpm setup:amazon-mcp`:
AMAZON_ORDERS_MCP_ENTRY=third_party/amazon-order-history-csv-download-mcp/dist/index.js
AMAZON_ORDERS_REGION=us
AMAZON_ORDERS_SYNC_TIMEOUT_MS=600000
YNAB_API_KEY=
YNAB_BUDGET_NAME=
